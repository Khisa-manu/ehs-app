# Gemini API Key (Server-side only)
GEMINI_API_KEY=

# Backend API Base URL (leave empty for same-origin, or set to e.g. https://yourdomain.com for external cPanel backend)
VITE_API_BASE_URL=

# Database Driver ('sqlite' for portable zero-config SQLite, or 'mysql' for cPanel MySQL/MariaDB)
DB_DRIVER=sqlite

# SQLite Database Path (used when DB_DRIVER=sqlite)
DB_SQLITE_PATH=fieldpulse.sqlite

# cPanel MySQL / MariaDB Database Credentials (used when DB_DRIVER=mysql)
DB_HOST=localhost
DB_NAME=fieldpulse_db
DB_USER=cpaneluser_db
DB_PASS=
DB_PORT=3306
